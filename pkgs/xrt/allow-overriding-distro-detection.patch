-
-if (${LINUX_FLAVOR} MATCHES "^centos")
+# The detection below reads /etc/os-release, which is not present on every
+# system XRT can be built on. Both variables are used unquoted in `if()`
+# conditions throughout the build, so an empty value is a configure error
+# rather than a fallback; let the caller supply them with -D instead.
+if (NOT LINUX_FLAVOR)
   execute_process(
-    COMMAND awk "{print $4}" /etc/redhat-release
+    COMMAND awk -F= "$1==\"ID\" {print $2}" /etc/os-release
     COMMAND tr -d "\""
-    OUTPUT_VARIABLE LINUX_VERSION
+    COMMAND awk "{print tolower($1)}"
+    OUTPUT_VARIABLE LINUX_FLAVOR
     OUTPUT_STRIP_TRAILING_WHITESPACE
   )
-else()
-  execute_process(
-    COMMAND awk -F= "$1==\"VERSION_ID\" {print $2}" /etc/os-release
-    COMMAND tr -d "\""
-    OUTPUT_VARIABLE LINUX_VERSION
-    OUTPUT_STRIP_TRAILING_WHITESPACE
-)
+endif()
+
+if (NOT LINUX_VERSION)
+  if (${LINUX_FLAVOR} MATCHES "^centos")
+    execute_process(
+      COMMAND awk "{print $4}" /etc/redhat-release
+      COMMAND tr -d "\""
+      OUTPUT_VARIABLE LINUX_VERSION
+      OUTPUT_STRIP_TRAILING_WHITESPACE
+    )
+  else()
+    execute_process(
+      COMMAND awk -F= "$1==\"VERSION_ID\" {print $2}" /etc/os-release
+      COMMAND tr -d "\""
+      OUTPUT_VARIABLE LINUX_VERSION
+      OUTPUT_STRIP_TRAILING_WHITESPACE
+    )
+  endif()
 endif()
 
 execute_process(COMMAND ${UNAME} -r
