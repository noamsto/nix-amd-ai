+// request["field"] on a const json& is undefined behavior when the key is
+// missing (JSON_ASSERT is compiled out in release builds): it segfaults or
+// returns garbage instead of throwing, and every handler below read its
+// required fields this way. Check presence and type before reading.
+// Ported from OpenFlowLM-Next's openai_compat::require_field
+// (src/server/openai_compat.hpp, Vegard Berget).
+enum class RequiredFieldType { String, Array };
+
+static json require_field(const json& request, const char* field, RequiredFieldType type) {
+    const char* want = type == RequiredFieldType::String ? "a string" : "an array";
+    if (!request.is_object())
+        return json{{"error", {
+            {"message", "the request body must be a JSON object."},
+            {"type", "invalid_request_error"}, {"param", ""}, {"code", "invalid_value"}}}};
+    if (!request.contains(field))
+        return json{{"error", {
+            {"message", std::string(field) + " is required and must be " + want + "."},
+            {"type", "invalid_request_error"}, {"param", field},
+            {"code", "missing_required_parameter"}}}};
+    const json& v = request[field];
+    const bool right = type == RequiredFieldType::String ? v.is_string() : v.is_array();
+    if (!right)
+        return json{{"error", {
+            {"message", std::string(field) + " must be " + want + "."},
+            {"type", "invalid_request_error"}, {"param", field}, {"code", "invalid_value"}}}};
+    return json();
+}
