+///@brief emit a handler's pending error into the already-started stream
+///@param body the serialized error response the handler left in res_
+///@note The 200 + chunked headers are already on the wire, so the status cannot
+/// change; the error goes out as the stream's final event, and
+/// send_chunk_data(..., true) terminates the chunked body, closes the socket and
+/// releases the slot (once). A throw while framing releases the slot directly
+/// so it never leaks.
+void HttpSession::write_streaming_error(const std::string& body) {
+    try {
+        const std::string target = std::string(req_.target());
+        if (target.rfind("/v1/", 0) == 0) {
+            // OpenAI SSE: data: {...}\n\n, in the same framing the stream used.
+            write_streaming_response(json("data: " + body + "\n\n"), true);
+        } else {
+            // Ollama NDJSON: one {"error": "..."} line. Ollama carries the
+            // error as a string, and its clients (ollama-python, the Go
+            // client) read `error` as one; collapse the handler's object body
+            // to its message rather than making them fail to parse. The
+            // message is already generic, so no exception text (#175).
+            json doc = json::parse(body);
+            if (doc.contains("error") && doc["error"].is_object() &&
+                doc["error"].contains("message") && doc["error"]["message"].is_string()) {
+                doc["error"] = doc["error"]["message"];
+            }
+            write_streaming_response(json(safe_dump(doc) + "\n"), true);
+        }
+    } catch (...) {
+        release_connection();
+    }
+}
