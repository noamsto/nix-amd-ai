@@ -134,6 +134,8 @@ void brief_print_message_response(nlohmann::json request) {
 // the default .dump() validates UTF-8, so building {"error": e.what()} and
 // dumping it threw a second time, escaping the catch before it released the
 // NPU lock. error_handler_t::replace substitutes U+FFFD instead of throwing.
+// Response bodies no longer carry e.what(), but safe_dump still guards
+// request text a handler echoes back (e.g. a model tag).
 // Ported from OpenFlowLM-Next's server.cpp (Vegard Berget).
 static std::string safe_dump(const json& j) {
     return j.dump(-1, ' ', false, json::error_handler_t::replace);
@@ -744,8 +746,8 @@ bool WebServer::handle_request(http::request<http::string_body>& req,
             }
 
             response_ref.result(status);
-            // response_data can be a handler's own {"error": e.what()} body,
-            // and e.what() is not guaranteed valid UTF-8.
+            // response_data can echo request text (e.g. a model tag), which
+            // is not guaranteed valid UTF-8.
             response_ref.body() = safe_dump(response_data);
             response_ref.set(http::field::content_type, "application/json");
             response_ref.prepare_payload();
