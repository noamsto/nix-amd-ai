+// e.what() can quote the request's own bytes and nlohmann's type-system
+// internals, so it goes to the server log, never into the response body.
+// request_fault marks a catch around prompt processing (insert(), or
+// generate_with_prompt(), which also decodes), where a chat template
+// rejecting the conversation throws a plain std::runtime_error; those
+// catches answered 400 before and still do.
+// Elsewhere a json::exception almost always means a request field had a
+// shape a handler didn't expect; anything else is a server fault.
+static json exception_error(const char* where, const std::exception& e, bool request_fault = false) {
+    header_print("ERROR", std::string(where) + ": " + e.what());
+    if (request_fault || dynamic_cast<const json::exception*>(&e))
+        return json{{"error", {{"message", "Invalid request"}, {"type", "invalid_request_error"},
+                               {"code", "invalid_value"}}}};
+    return json{{"error", {{"message", "Internal error"}, {"type", "server_error"}}}};
+}
