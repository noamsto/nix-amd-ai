+// Ported from OpenFlowLM-Next's openai_compat::model_error
+// (src/server/openai_compat.hpp, Vegard Berget).
+static json model_error(RestHandler::ModelLoad why, const std::string& model) {
+    switch (why) {
+        case RestHandler::ModelLoad::Unknown:
+            return json{{"error", {
+                {"message", "model '" + model + "' is not in this build's model list"},
+                {"type", "invalid_request_error"}, {"param", "model"}, {"code", "model_not_found"}}}};
+        case RestHandler::ModelLoad::NotChatModel:
+            return json{{"error", {
+                {"message", "model '" + model + "' is not a chat model; this endpoint serves "
+                            "text generation only"},
+                {"type", "invalid_request_error"}, {"param", "model"}, {"code", "model_not_found"}}}};
+        case RestHandler::ModelLoad::NoModel:
+            return json{{"error", {
+                {"message", "no chat model is currently loaded (none was given at startup, or the "
+                            "last load failed). Name a model in the request's 'model' field, or "
+                            "start flm serve with a model tag."},
+                {"type", "invalid_request_error"}, {"param", "model"}, {"code", "model_not_found"}}}};
+        case RestHandler::ModelLoad::LoadFailed:
+        default:
+            return json{{"error", {
+                {"message", "model '" + model + "' is known to this build but could not be "
+                            "loaded; the server log says why"},
+                {"type", "server_error"}, {"param", "model"}, {"code", "model_load_failed"}}}};
+    }
+}
