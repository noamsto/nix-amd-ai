+// A malformed body with invalid UTF-8 used to wedge the server permanently:
+// nlohmann puts the offending bytes into a caught exception's e.what(), and
+// the default .dump() validates UTF-8, so building {"error": e.what()} and
+// dumping it threw a second time, escaping the catch before it released the
+// NPU lock. error_handler_t::replace substitutes U+FFFD instead of throwing.
+// Ported from OpenFlowLM-Next's server.cpp (Vegard Berget).
+static std::string safe_dump(const json& j) {
+    return j.dump(-1, ' ', false, json::error_handler_t::replace);
+}
+
+// Releases the NPU lock exactly once per held acquisition, regardless of
+// which exit path process_task takes, including an exception that escapes
+// every catch in process_task uncaught (WebServer::start() wraps ioc.run()
+// in a try/catch per I/O thread, so that doesn't crash the process, but it
+// skips a manually-placed release call and wedges the NPU the same way).
+// Takes a closure rather than a WebServer* + method, since this struct is
+// not a member or friend of WebServer and process_next_npu_request() is
+// private.
+struct NpuReleaseGuard {
+    std::function<void()> release_fn;
+    bool needs_npu;
+    std::atomic<bool> released{false};
+    NpuReleaseGuard(std::function<void()> release_fn, bool needs_npu)
+        : release_fn(std::move(release_fn)), needs_npu(needs_npu) {}
+    void release() {
+        if (needs_npu && !released.exchange(true)) {
+            release_fn();
+        }
+    }
+    ~NpuReleaseGuard() { release(); }
+};
+
