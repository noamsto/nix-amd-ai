-                std::string model_size = this->config["models"][model_type].begin().key();
+                // A bare tag whose size map is missing, not an object, or empty
+                // has no first size: begin() is end(), and .key() on it is
+                // undefined behavior, while a non-object map throws
+                // invalid_iterator. Neither is a tag this method can resolve, so
+                // refuse it as a malformed entry instead.
+                const auto& model_map = this->config.at("models");
+                auto subset = model_map.find(model_type);
+                if (subset == model_map.end() || !subset->is_object() || subset->empty()) {
+                    throw std::runtime_error("model '" + model_type + "' has no size variants");
+                }
+                std::string model_size = subset->begin().key();
                 new_tag = model_type + ":" + model_size;
             }
             return new_tag;
