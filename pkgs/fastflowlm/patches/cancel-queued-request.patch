+// Routes whose handler composes the request's cancellation token into its
+// generation loop (the predicate passed to insert()/generate()). Only those can
+// act on a cancel, so only those register while queued. The other NPU routes
+// (embeddings, audio) have no cancellation path, so registering them before they
+// run would answer POST /api/cancel with cancelled:true and then run them in
+// full; they keep registering when they start, as before. Keep in sync with
+// requires_npu_access() above and the handler signatures in rest_handler.hpp.
+static bool handler_honours_cancel(const std::string& key) {
+    return key == "POST /api/generate" ||
+           key == "POST /api/chat" ||
+           key == "POST /v1/chat/completions" ||
+           key == "POST /v1/completions";
+}
