 ///@return the rest handler
 RestHandler::~RestHandler() = default;
 
+///@brief Publish the chat model tag that /api/ps lists
+///@param tag the serving tag, or empty when no chat model is serving
+void RestHandler::publish_serving_chat_tag(std::string tag) {
+    std::lock_guard<std::mutex> lock(loaded_model_mutex);
+    serving_chat_tag = std::move(tag);
+}
+
+///@brief Snapshot the chat model tag that /api/ps lists
+///@return the serving tag, or empty when no chat model is serving
+std::string RestHandler::serving_chat_tag_snapshot() const {
+    std::lock_guard<std::mutex> lock(loaded_model_mutex);
+    return serving_chat_tag;
+}
