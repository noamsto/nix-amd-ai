+// A guessable default id would let any client cancel another's request via
+// POST /api/cancel. getrandom(2) for <= 256 bytes never returns short once
+// the pool is initialised (it blocks until then), so a failure is fatal
+// rather than a reason to fall back to a guessable id.
+static std::string random_request_id() {
+    unsigned char bytes[16];
+    if (getrandom(bytes, sizeof bytes, 0) != static_cast<ssize_t>(sizeof bytes)) std::abort();
+    static const char hex[] = "0123456789abcdef";
+    std::string id = "req_";
+    for (unsigned char b : bytes) { id += hex[b >> 4]; id += hex[b & 0xf]; }
+    return id;
+}
+
