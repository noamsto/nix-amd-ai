+// A guessable default request id lets any client cancel another client's
+// in-flight request via POST /api/cancel, so draw 128 bits from the kernel.
+// getrandom(2) for <= 256 bytes never returns short or EINTR once the pool
+// is initialised, and blocks until then. Abort rather than throw: the call
+// site is outside every catch in process_task, so an exception would leave
+// the client without a response; and a weaker fallback would silently make
+// ids guessable again.
+static std::string random_request_id() {
+    unsigned char bytes[16];
+    if (getrandom(bytes, sizeof bytes, 0) != static_cast<ssize_t>(sizeof bytes)) std::abort();
+    static const char hex[] = "0123456789abcdef";
+    std::string id = "req_";
+    for (unsigned char b : bytes) { id += hex[b >> 4]; id += hex[b & 0xf]; }
+    return id;
+}
+
 // Releases the NPU lock exactly once per held acquisition, regardless of
