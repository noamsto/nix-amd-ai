+namespace lemon {
+namespace backends {
+namespace strata {
+
+// The strata backend descriptor (plain data). Strata (Niko1221/Strata) is a
+// Qwen3.8-Flash-Next engine for Strix Halo. Nix builds it against TheRock ROCm
+// and points strata.rocm_bin at a shim that starts the engine; lemonade spawns
+// the shim as its subprocess and proxies requests, exactly like the ds4
+// backend. Upstream publishes no binaries, so there is no managed install.
+inline const BackendDescriptor descriptor = {
+    /*recipe*/          "strata",
+    /*display_name*/    "Strata (experimental)",
+    /*binary*/          "strata-lemond-shim",
+    /*config_section*/  "",  // defaults to recipe
+    /*default_device*/  DEVICE_GPU,
+    /*slot_policy*/     SlotPolicy::Standard,
+    /*selectable_backend*/ false,  // rocm is the only variant; no option to declare
+    /*uses_ctx_size*/   true,
+    /*dynamic_models*/  false,
+    /*options*/ {
+        {"strata_args", "--strata-args", "", "ARGS",
+         "Custom arguments to pass to the Strata shim", "Strata Options"},
+    },
+    /*support*/ {
+        {"rocm", {"linux"}, {{"amd_gpu", {"gfx1151"}}}, "Strata shim for AMD Strix Halo"},
+    },
+    /*supported_modes*/ {"chat"},
+    /*required_checkpoints*/ {"main"},
+    /*default_capabilities*/ {},
+    /*experimental*/    true,
+    /*web_display_name*/ "",
+    /*rocm_channels*/   {},  // single rocm artifact, no stable/nightly channels
+    /*exposes_prometheus_metrics*/ false,
+    /*rocm_requires_cwsr_fix*/ true,
+    /*version_policy*/  VersionPolicy::Exact,
+    /*self_manages_downloads*/ false,
+    /*takes_args*/      true,
+    /*arg_variants*/    {},
+    /*bin_variants*/    {},
+    /*config_extra*/    nlohmann::json::object(),
+    /*streams_model_from_storage*/ true,
+};
+
+}  // namespace strata
+}  // namespace backends
+}  // namespace lemon
--- a/src/cpp/include/lemon/backends/strata/strata_server.h	1970-01-01 02:00:00.000000000 +0200
