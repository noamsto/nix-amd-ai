+// Direct host access returns wrong data on RDNA3.5 iGPUs. Measured on both
+// gfx1151 (Strix Halo) and gfx1150 (Strix Point): perplexity explodes with
+// offload while CPU and Vulkan on the same box stay correct.
+static bool ggml_cuda_is_rdna3_5(const int device) {
+    return GGML_CUDA_CC_IS_RDNA3_5(ggml_cuda_info().devices[device].cc);
+}
